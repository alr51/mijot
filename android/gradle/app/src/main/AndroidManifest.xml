<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Seul usage du réseau : les suggestions de prix (Open Prices), sur demande. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Rendu wgpu : Vulkan si possible, sinon OpenGL ES 3. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" android:version="0" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" android:version="0x00401000" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!--
      `enableOnBackInvokedCallback="false"` : « retour » arrive comme une touche,
      que gpui-mobile transmet à l'application (Échap : fermer le volet ouvert),
      au lieu de fermer directement l'activité.
    -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/GpuiTheme"
    >
        <!--
          GpuiActivity (gpui-mobile) étend NativeActivity : elle charge la
          bibliothèque Rust nommée ci-dessous, qui pilote toute l'application,
          et garde l'écran de démarrage jusqu'à ce qu'elle soit prête.
          `configChanges` : la rotation, le clavier, la langue ou la taille de
          police ne recréent pas l'activité (voir la fin de `android_main`).
        -->
        <activity
            android:name="dev.gpui.mobile.GpuiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|locale|layoutDirection|fontScale|touchscreen|mcc|mnc"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/GpuiSplashTheme"
            android:windowSoftInputMode="adjustResize"
        >
            <meta-data android:name="android.app.lib_name" android:value="${nativeLibraryName}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
